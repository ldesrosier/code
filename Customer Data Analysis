# ==============================
# SQL ANALYSIS
# ==============================

"""
SQL Queries Used:

-- Combine online and in-store transactions

CREATE TABLE All_Orders AS
SELECT
    CustomerID,
    OrderID,
    Order_date,
    Item1ID,
    Item1Qty,
    Item1Price,
    Item2ID,
    Item2Qty,
    Item2Price,
    Item3ID,
    Item3Qty,
    Item3Price,
    Total_Price
FROM Online_Orders

UNION ALL

SELECT
    CustomerID,
    OrderID,
    Order_date,
    Item1ID,
    Item1Qty,
    Item1Price,
    Item2ID,
    Item2Qty,
    Item2Price,
    Item3ID,
    Item3Qty,
    Item3Price,
    `Total Price` AS Total_Price
FROM Orders;


-- Analyze customer spending

SELECT
    c.CustomerID,
    c.FirstName,
    c.LastName,
    c.City,
    SUM(o.Total_Price) AS Total_Spending
FROM Customers c
INNER JOIN All_Orders o
    ON c.CustomerID = o.CustomerID
GROUP BY
    c.CustomerID,
    c.FirstName,
    c.LastName,
    c.City
ORDER BY Total_Spending DESC;


-- Identify top customers

SELECT
    CustomerID,
    SUM(Total_Price) AS Lifetime_Value
FROM All_Orders
GROUP BY CustomerID
ORDER BY Lifetime_Value DESC
LIMIT 10;
"""


# ==============================
# PYTHON / PANDAS ANALYSIS
# ==============================

import pandas as pd
import matplotlib.pyplot as plt


# Load SQL exported dataset
orders = pd.read_csv("All_Orders.csv")


# Review dataset
print(orders.head())
print(orders.info())


# Convert dates
orders["Order_date"] = pd.to_datetime(orders["Order_date"])


# Customer spending analysis
customer_spending = (
    orders.groupby("CustomerID")["Total_Price"]
    .sum()
    .sort_values(ascending=False)
)

print("\nTop Customers:")
print(customer_spending.head(10))


# Monthly revenue analysis
monthly_revenue = (
    orders.groupby(
        orders["Order_date"].dt.to_period("M")
    )["Total_Price"]
    .sum()
)

print("\nMonthly Revenue:")
print(monthly_revenue)


# Revenue visualization
monthly_revenue.plot(
    kind="line",
    marker="o",
    title="Monthly Revenue Trends"
)

plt.xlabel("Month")
plt.ylabel("Revenue")
plt.xticks(rotation=45)

plt.tight_layout()
plt.show()


# Export results
customer_spending.to_csv(
    "customer_spending_analysis.csv"
)

print("Analysis complete.")
