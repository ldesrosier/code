-- Customer Data Analysis Project
-- Objective: Analyze customer purchasing behavior by combining online and in-store order data
-- to identify spending patterns, revenue trends, and high-value customers.

-- 1. Create a combined orders table from online and in-store transactions

CREATE TABLE All_Orders AS
SELECT
    CustomerID,
    OrderID,
    Order_date,
    Item1ID,
    Item1Qty,
    Item1Price,
    Item2ID,
    Item2Qty,
    Item2Price,
    Item3ID,
    Item3Qty,
    Item3Price,
    Total_Price
FROM Online_Orders

UNION ALL

SELECT
    CustomerID,
    OrderID,
    Order_date,
    Item1ID,
    Item1Qty,
    Item1Price,
    Item2ID,
    Item2Qty,
    Item2Price,
    Item3ID,
    Item3Qty,
    Item3Price,
    `Total Price` AS Total_Price
FROM Orders;


-- 2. Analyze total spending by customer

SELECT
    c.CustomerID,
    c.FirstName,
    c.LastName,
    c.City,
    SUM(o.Total_Price) AS Total_Spending
FROM Customers AS c
INNER JOIN All_Orders AS o
    ON c.CustomerID = o.CustomerID
GROUP BY
    c.CustomerID,
    c.FirstName,
    c.LastName,
    c.City
ORDER BY Total_Spending DESC;


-- 3. Identify top customers by lifetime spending

SELECT
    CustomerID,
    SUM(Total_Price) AS Lifetime_Value
FROM All_Orders
GROUP BY CustomerID
ORDER BY Lifetime_Value DESC
LIMIT 10;


-- 4. Analyze monthly revenue trends

SELECT
    DATE_FORMAT(Order_date, '%Y-%m') AS Month,
    SUM(Total_Price) AS Monthly_Revenue
FROM All_Orders
WHERE Order_date BETWEEN '2023-01-01' AND '2023-06-30'
GROUP BY Month
ORDER BY Month;


-- 5. Export combined dataset for visualization

SELECT *
FROM All_Orders;
