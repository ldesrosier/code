-- Customer Credit Card Database Analysis
-- Objective: Design a relational database and analyze customer account information
-- including card types, account status, and transaction activity.

-- 1. Create Customer Table

CREATE TABLE Customer (
    CustomerID INT NOT NULL PRIMARY KEY,
    CustName VARCHAR(50),
    CustAddress VARCHAR(250)
);


-- 2. Create Card Account Table

CREATE TABLE CardAccount (
    AccountID BIGINT PRIMARY KEY,
    ExpDate DATE,
    CardType VARCHAR(50),
    CustomerID INT,
    FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)
);


-- 3. Create Debit Card Table

CREATE TABLE DebitCard (
    DAccountID BIGINT PRIMARY KEY,
    BankNo VARCHAR(20),
    AccountID BIGINT,
    FOREIGN KEY (AccountID) REFERENCES CardAccount(AccountID)
);


-- 4. Create Credit Card Table

CREATE TABLE CreditCard (
    CAccountID BIGINT PRIMARY KEY,
    CurrBal DECIMAL(10,2),
    AccountID BIGINT,
    FOREIGN KEY (AccountID) REFERENCES CardAccount(AccountID)
);


-- 5. Create Merchant Table

CREATE TABLE Merchant (
    MerchID INT PRIMARY KEY,
    MerchAddr VARCHAR(250)
);


-- 6. Create Transaction Charges Table

CREATE TABLE Charges (
    MerchID INT,
    CAccountID BIGINT,
    ChargeDate DATE,
    ChargeTime TIME,
    Amount DECIMAL(10,2),
    PRIMARY KEY (MerchID, CAccountID, ChargeDate, ChargeTime),
    FOREIGN KEY (MerchID) REFERENCES Merchant(MerchID),
    FOREIGN KEY (CAccountID) REFERENCES CreditCard(CAccountID)
);


-- ANALYSIS QUERIES


-- 1. View all credit card accounts

SELECT *
FROM CardAccount
WHERE CardType = 'credit';


-- 2. Identify accounts expiring within a specific timeframe

SELECT
    AccountID,
    CardType,
    ExpDate
FROM CardAccount
WHERE ExpDate BETWEEN '2024-01-01' AND '2025-12-31';


-- 3. Analyze customer account information

SELECT
    c.CustomerID,
    c.CustName,
    ca.AccountID,
    ca.CardType,
    ca.ExpDate
FROM Customer c
INNER JOIN CardAccount ca
    ON c.CustomerID = ca.CustomerID;


-- 4. Analyze total spending by credit card customer

SELECT
    ca.CustomerID,
    SUM(ch.Amount) AS Total_Spending
FROM CardAccount ca
INNER JOIN CreditCard cc
    ON ca.AccountID = cc.AccountID
INNER JOIN Charges ch
    ON cc.CAccountID = ch.CAccountID
GROUP BY ca.CustomerID
ORDER BY Total_Spending DESC;


-- 5. Identify highest spending merchants

SELECT
    MerchID,
    SUM(Amount) AS Total_Revenue
FROM Charges
GROUP BY MerchID
ORDER BY Total_Revenue DESC;



	
